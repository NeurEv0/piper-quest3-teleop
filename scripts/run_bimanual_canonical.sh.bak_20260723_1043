#!/usr/bin/env bash
# Launch real dual-Piper Quest3 teleoperation with Canonical Raw recording.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${REPO_ROOT}"

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate lerobot

export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
unset VUER_HTTP

LEFT_CAN="${LEFT_CAN:-can_left}"
RIGHT_CAN="${RIGHT_CAN:-can_right}"
OUTPUT_ROOT="${OUTPUT_ROOT:-/home/ylhp-e-ai/ZHITAI_1t/piper_canonical_raw}"
DASHBOARD_PORT="${DASHBOARD_PORT:-8020}"
ENABLE_MCAP="${ENABLE_MCAP:-0}"
EXTRA_ARGS=()
if [[ "${ENABLE_MCAP}" == "1" ]]; then
  EXTRA_ARGS+=(--enable-mcap)
fi

mkdir -p Log "${OUTPUT_ROOT}"
LOG_FILE="Log/bimanual_canonical_$(date +%Y%m%d_%H%M%S).log"

echo "Canonical Raw dual-arm recording"
echo "  Quest URL: https://localhost:8012?ws=wss://localhost:8012"
echo "  Operator dashboard: http://localhost:${DASHBOARD_PORT}"
echo "  Dataset root: ${OUTPUT_ROOT}"
echo "  Raw MCAP: ${ENABLE_MCAP}"
echo "  Log: ${REPO_ROOT}/${LOG_FILE}"

exec > >(tee -a "${LOG_FILE}") 2>&1
exec python scripts/record_bimanual_canonical.py \
  --left-can "${LEFT_CAN}" \
  --right-can "${RIGHT_CAN}" \
  --output-root "${OUTPUT_ROOT}" \
  --dashboard-port "${DASHBOARD_PORT}" \
  "${EXTRA_ARGS[@]}" \
  "$@"
